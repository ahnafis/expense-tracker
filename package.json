{
    "name": "expense-tracker",
    "version": "1.0.0",
    "description": "A simple tool to manage your expenses.",
    "keywords": [],
    "author": "",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "format-check": "prettier --check .",
        "lint": "eslint",
        "test": "pnpm -r --if-present test",
        "watch-tests": "pnpm -r --if-present watch-tests",
        "start": "pnpm --filter @apps/mobile start",
        "android": "pnpm --filter @apps/mobile android",
        "ios": "pnpm --filter @apps/mobile ios"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "24.22.1",
            "onFail": "download"
        },
        "packageManager": {
            "name": "pnpm",
            "version": "12.15.0",
            "onFail": "download"
        }
    },
    "packageManager": "pnpm@12.15.0",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.13.0",
        "globals": "^17.13.0",
        "prettier": "^3.9.10",
        "typescript-eslint": "^8.72.0"
    }
}
