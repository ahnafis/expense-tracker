{
    "compilerOptions": {
        "target": "ESNext",
        "lib": ["ESNext"],

        "module": "ESNext",
        "moduleResolution": "bundler",

        "strict": true,
        "skipLibCheck": true,

        "noEmit": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,

        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,

        "baseUrl": ".",
        "paths": {
            "@/*": ["src/*"]
        }
    },

    "include": ["src", "tests", "vite.config.ts"]
}
