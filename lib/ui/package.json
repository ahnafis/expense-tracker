{
    "name": "@lib/ui",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./components": {
            "types": "./dist/components/index.d.ts",
            "import": "./dist/components/index.js"
        }
    },
    "scripts": {
        "clean": "rm -rf ./dist",
        "dev": "concurrently -k \"tsc -p tsconfig.build.json --watch\" \"tsc-alias -p tsconfig.build.json --watch\"",
        "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "react": "19.2.3",
        "react-native": "0.86.3"
    },
    "devDependencies": {
        "@types/react": "~19.2.2",
        "typescript": "~6.0.3"
    }
}
